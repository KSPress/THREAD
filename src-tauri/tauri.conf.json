{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THREAD",
  "version": "0.1.0",
  "identifier": "com.kspress.thread",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "THREAD",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#303830"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first worldbuilding & writing workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
